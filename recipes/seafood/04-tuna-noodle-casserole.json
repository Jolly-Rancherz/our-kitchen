  "steps": [
    {
      "title": "Noodles",
      "text": "Heat the oven to 190°C (375°F). Cook the noodles in a large pot of boiling salted water 2 minutes less than the package says, and drain.",
      "timer": 5,
      "uses": [
        "0-0",
        "0-1"
      ]
    },
    {
      "title": "Soften",
      "text": "Meanwhile, melt the butter in a large saucepan over medium and cook the onion and celery 5–6 minutes until soft.",
      "timer": 6,
      "uses": [
        "1-0",
        "1-1",
        "1-2"
      ]
    },
    {
      "title": "Sauce",
      "text": "Stir in the flour for 1 minute. Whisk in the milk and broth a little at a time, add the dried thyme, salt and pepper, and simmer 3–4 minutes, stirring, until thick.",
      "timer": 4,
      "uses": [
        "1-3",
        "1-4",
        "1-5",
        "1-6",
        "1-7",
        "1-8"
      ]
    },
    {
      "title": "Combine",
      "text": "Off the heat, stir in the cheddar until melted, then fold in the noodles, tuna and peas. Spread in a 9×13-inch (23×33 cm) baking dish.",
      "uses": [
        "1-9",
        "1-10",
        "1-11"
      ]
    },
    {
      "title": "Top",
      "text": "Toss the panko with the melted butter and cheddar and scatter over the top.",
      "uses": [
        "2-0",
        "2-1",
        "2-2"
      ]
    },
    {
      "title": "Bake",
      "text": "Bake uncovered 20–25 minutes, until bubbling at the edges and golden on top. Rest 5 minutes.",
      "timer": 22,
      "uses": []
    }
  ],
