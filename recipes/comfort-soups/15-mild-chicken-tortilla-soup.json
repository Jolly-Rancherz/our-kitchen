    },
    {
      "title": "Simmer the chicken",
      "text": "Add the crushed tomatoes, broth, salt and the whole chicken breasts. Bring to a boil, then simmer, partly covered, 18–22 minutes, until the chicken reads 74°C (165°F) in the thickest part.",
      "timer": 20,
      "uses": [
        "0-7",
        "0-8",
        "0-13",
        "0-9"
      ]
    },
    {
      "title": "Shred",
      "text": "Lift the chicken onto a board and shred it with two forks.",
      "uses": []
    },
    {
      "title": "Finish",
      "text": "Return the chicken with the beans and corn and simmer 5 minutes. Stir in 2 tbsp lime juice and taste for salt.",
