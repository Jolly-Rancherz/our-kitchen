  "steps": [
    {
      "title": "Base",
      "text": "Heat the oil in a large pot over medium. Cook the onion 5 minutes until soft. Add the garlic, chili powder, cumin, paprika and dried oregano and stir 1 minute.",
      "timer": 6,
      "uses": [
        "0-0",
        "0-1",
