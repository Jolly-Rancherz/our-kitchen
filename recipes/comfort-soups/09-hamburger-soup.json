  "steps": [
    {
      "title": "Brown the beef",
      "text": "Heat the oil in the pot over medium-high. Cook the beef and onion, breaking up the beef, 8–10 minutes until no pink remains and it reads 71°C (160°F). Spoon off the fat.",
      "timer": 9,
      "uses": [
        "0-0",
        "0-1",
        "0-2"
      ]
    },
    {
      "title": "Vegetables",
      "text": "Add the carrots and celery and cook 5 minutes. Stir in the garlic and tomato paste for 1 minute.",
      "timer": 6,
      "uses": [
        "0-3",
        "0-4",
        "0-5",
        "0-6"
      ]
    },
    {
      "title": "Simmer",
      "text": "Add the crushed tomatoes, broth, potatoes, Worcestershire, dried thyme, bay leaf, salt and pepper. Bring to a boil, then simmer, partly covered, 20–25 minutes, until the potatoes are tender.",
