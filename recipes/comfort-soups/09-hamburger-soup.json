  "fixIt": [
    {
      "problem": "Soup greasy",
      "fix": "Spoon off the beef fat before adding the vegetables; chill leftovers and lift off any fat."
    },
    {
      "problem": "Potatoes falling apart",
      "fix": "Yukon Golds hold their shape; simmer gently, not at a rolling boil."
    },
    {
      "problem": "Too thick the next day",
      "fix": "Thin with broth or water when reheating."
    }
