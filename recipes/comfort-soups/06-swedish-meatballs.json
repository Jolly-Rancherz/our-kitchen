  "steps": [
    {
      "title": "Soak the crumbs",
      "text": "Stir the panko, milk, egg and grated onion together in a large bowl and let stand 5 minutes.",
      "timer": 5,
      "uses": [
        "0-0",
        "0-1",
        "0-2",
        "0-3"
      ]
    },
    {
      "title": "Mix and roll",
      "text": "Add the beef, pork, salt, pepper, allspice and nutmeg and mix gently with your hands. Roll into 3 cm balls (about 30).",
      "uses": [
        "0-4",
        "0-5",
        "0-6",
        "0-7",
        "0-8",
        "0-9"
      ]
    },
    {
      "title": "Brown",
      "text": "Heat the oil and butter in a large deep skillet over medium-high. Brown the meatballs in 2 batches, 6–8 minutes, turning, until browned all over. Move to a plate. Put the noodle water on to boil with the salt.",
      "timer": 7,
      "uses": [
        "0-10",
        "0-11",
        "2-1"
      ]
    },
    {
      "title": "Gravy",
      "text": "Lower the heat to medium. Melt the butter in the skillet, whisk in the flour and cook 1 minute, until light brown. Whisk in the broth a little at a time, then the cream and Worcestershire, and simmer 2 minutes.",
      "timer": 3,
      "uses": [
        "1-0",
        "1-1",
        "1-2",
        "1-3",
        "1-4"
      ]
    },
    {
      "title": "Simmer",
      "text": "Return the meatballs, cover and simmer gently 8–10 minutes, until they reach 71°C (160°F) in the centre.",
      "timer": 9,
      "uses": []
    },
    {
      "title": "Noodles",
      "text": "Meanwhile, cook the noodles 6–8 minutes, drain and toss with the butter.",
      "timer": 7,
      "uses": [
        "2-0",
        "2-2"
      ]
    },
    {
      "title": "Serve",
      "text": "Spoon the meatballs and gravy over the noodles.",
      "uses": []
    }
  ],
