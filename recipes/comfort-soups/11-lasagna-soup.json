  "steps": [
    {
      "title": "Brown",
      "text": "Heat the oil in a large pot over medium-high. Cook the beef and onion, breaking up the beef, 8–10 minutes until no pink remains and it reads 71°C (160°F). Spoon off the fat. Add the garlic and tomato paste and stir 1 minute.",
      "timer": 9,
      "uses": [
        "0-0",
        "0-1",
        "0-2",
        "0-3",
        "0-4"
      ]
    },
    {
      "title": "Simmer",
      "text": "Add the crushed tomatoes, broth, Italian seasoning, sugar, salt and pepper. Bring to a boil, then simmer 10 minutes.",
      "timer": 10,
      "uses": [
        "0-5",
        "0-6",
        "0-7",
        "0-8",
        "0-9",
        "0-10"
      ]
