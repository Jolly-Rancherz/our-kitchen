  "steps": [
    {
      "title": "Soften",
      "text": "Heat the oil in a large pot over medium. Cook the onion, carrots and celery 6–8 minutes until soft. Add the garlic for 30 seconds.",
      "timer": 7,
      "uses": [
        "0-0",
        "0-1",
        "0-2",
        "0-3",
        "0-4"
      ]
    },
    {
      "title": "Simmer",
      "text": "Add the split peas, broth, water, bay leaf, dried thyme and pepper. Bring to a boil, then simmer, partly covered, 60–75 minutes, stirring now and then so nothing sticks, until the peas fall apart.",
      "timer": 70,
      "uses": [
        "0-5",
        "0-6",
        "0-7",
        "0-8",
        "0-9",
        "0-10"
      ]
    },
    {
      "title": "Ham",
      "text": "Discard the bay leaf. Stir in the diced ham and simmer 10 minutes, until the soup is thick and the ham is 74°C (165°F).",
      "timer": 10,
      "uses": [
        "0-11"
      ]
    },
    {
      "title": "Season",
      "text": "Taste and add salt only if it needs it. Thin with a splash of water if it's too thick.",
      "uses": [
        "0-12"
      ]
    }
  ],
  "together": "AAA*",
  "fixIt": [
    {
      "problem": "Peas still whole",
      "fix": "Old peas take longer. Keep simmering, or mash some against the pot."
