  "steps": [
    {
      "title": "Soften",
      "text": "Melt the butter in the pot over medium. Cook the onion, carrots and celery 7–8 minutes until softened. Add the garlic for 30 seconds.",
      "timer": 8,
      "uses": [
        "0-0",
        "0-1",
        "0-2",
        "0-3",
        "0-4"
      ]
    },
    {
      "title": "Thicken",
      "text": "Stir in the flour, dried thyme and dried sage for 1 minute, then whisk in the broth a little at a time.",
      "timer": 1,
      "uses": [
        "0-5",
        "0-6",
        "0-7",
        "0-8"
      ]
    },
    {
      "title": "Poach the chicken",
      "text": "Add the chicken, bring to a simmer and cook, partly covered, 15–18 minutes, until the chicken reaches 74°C (165°F). Lift it out, shred with 2 forks and return it to the pot with the milk, peas, salt and pepper.",
      "timer": 17,
      "uses": [
        "0-9",
        "0-10",
        "0-11",
        "0-12",
        "0-13"
      ]
    },
    {
      "title": "Dumpling dough",
      "text": "While the chicken poaches, whisk the flour, baking powder and salt in a bowl. Stir in the melted butter and milk with a fork just until a soft, sticky dough forms.",
      "uses": [
        "1-0",
        "1-1",
        "1-2",
        "1-3",
        "1-4"
      ]
    },
    {
      "title": "Steam the dumplings",
      "text": "Bring the stew back to a gentle simmer. Drop in heaping tablespoons of dough (about 12) over the surface. Cover and simmer 15 minutes without lifting the lid, until the dumplings are puffed and cooked through (a toothpick comes out clean).",
      "timer": 15,
      "uses": []
    },
    {
      "title": "Serve",
      "text": "Ladle the stew and dumplings into bowls.",
      "uses": []
    }
  ],
  "together": "AAAB**",
  "fixIt": [
    {
      "problem": "Dumplings dense or gummy",
      "fix": "Mix the dough only until it comes together, and don't lift the lid while they steam."
    },
    {
      "problem": "Dumplings dissolving",
      "fix": "The stew was boiling hard. Keep it at a gentle simmer."
    },
    {
      "problem": "Stew too thick",
      "fix": "The dumplings absorb liquid; stir in a splash of broth when serving."
    }
  ],
