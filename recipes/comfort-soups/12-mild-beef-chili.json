  "steps": [
    {
      "title": "Brown",
      "text": "Heat the oil in a large heavy pot over medium-high. Cook the beef and onion, breaking up the beef, 8–10 minutes until no pink remains and it reads 71°C (160°F). Spoon off the fat.",
      "timer": 9,
      "uses": [
        "0-0",
        "0-1",
        "0-2"
      ]
    },
    {
      "title": "Spices",
      "text": "Add the garlic, chili powder, cumin, paprika, dried oregano and tomato paste and stir 1 minute until fragrant.",
      "timer": 1,
      "uses": [
        "0-3",
        "0-4",
        "0-5",
        "0-6",
        "0-7",
        "0-8"
      ]
    },
    {
      "title": "Simmer",
      "text": "Add the crushed tomatoes, beans, broth, brown sugar, salt and pepper. Bring to a boil, then simmer, partly covered, 40 minutes, stirring now and then, until thick.",
