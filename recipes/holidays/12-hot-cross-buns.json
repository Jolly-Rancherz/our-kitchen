      ]
    },
    {
      "title": "Knead",
      "text": "Knead in the rest of the flour 6–8 minutes until smooth, then knead in the raisins.",
      "uses": [
        "0-5=½ cup",
        "0-10"
      ]
    },
    {
      "title": "First rise",
      "text": "Cover in a greased bowl and let rise somewhere warm about 1 hour, until doubled.",
      "timer": 60,
      "uses": []
    },
    {
      "title": "Shape",
      "text": "Divide into 12 pieces, roll into smooth balls and set them close together in a greased 23×33 cm (9×13 in) pan. Cover and rise 40–45 minutes until puffy. Heat the oven to 190°C (375°F).",
      "timer": 42,
      "uses": []
    },
    {
      "title": "Cross",
      "text": "Stir the flour and water into a thick paste, spoon it into a zip bag, snip a small corner and pipe a cross over each row of buns.",
      "uses": [
        "1-0",
        "1-1"
      ]
    },
    {
      "title": "Bake",
      "text": "Bake 20–22 minutes, until deep golden and the centre bun reads 88°C (190°F).",
      "timer": 21,
      "uses": []
    },
    {
      "title": "Glaze",
      "text": "Warm the honey 10 seconds in the microwave and brush over the hot buns.",
      "uses": [
