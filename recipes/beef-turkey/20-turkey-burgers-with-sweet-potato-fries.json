  "steps": [
    {
      "title": "Fries",
      "text": "Heat the oven to 220°C (425°F). Toss the sweet potato sticks with the cornstarch, then the oil, paprika and salt. Spread on a parchment-lined baking sheet, not touching, and bake 25–30 minutes, turning once, until crisp at the edges.",
      "timer": 28,
      "uses": [
        "0-0",
        "0-1",
        "0-2",
        "0-3",
        "0-4"
      ]
    },
    {
      "title": "Shape",
      "text": "Mix the turkey, panko, Worcestershire, garlic powder, onion powder, salt and pepper gently. Shape 4 patties 2 cm thick with a thumbprint in the middle.",
      "uses": [
        "1-0",
        "1-1",
        "1-2",
        "1-3",
        "1-4",
        "1-5",
        "1-6"
      ]
    },
    {
      "title": "Cook",
      "text": "Heat the oil in a large skillet over medium. Cook the patties 5–6 minutes a side, until browned and 74°C (165°F) in the centre. Lay a cheddar slice on each for the last minute, covered.",
      "timer": 12,
      "uses": [
        "1-7",
        "2-3"
      ]
    },
    {
      "title": "Burger sauce",
      "text": "Stir the mayonnaise and ketchup together. Toast the buns cut side down in a dry pan, 1 minute.",
      "uses": [
        "2-0",
        "2-1",
        "2-2"
      ]
    },
    {
      "title": "Build",
      "text": "Spread the sauce on the buns and add lettuce, a burger and tomato. Serve with the fries.",
      "uses": [
        "2-4",
        "2-5"
      ]
    }
