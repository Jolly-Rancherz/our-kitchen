  "steps": [
    {
      "title": "Soften the vegetables",
      "text": "Heat the oil in a heavy pot over medium. Cook the onion, carrot and celery 8 minutes, stirring, until soft.",
      "timer": 8,
      "uses": [
        "0-0",
        "0-1",
        "0-2",
        "0-3"
      ]
    },
    {
      "title": "Brown the beef",
      "text": "Turn the heat to medium-high, add the beef and cook, breaking it up, 8–10 minutes until no pink remains and it reads 71°C (160°F). Spoon off any fat. Add the garlic and tomato paste and stir 1 minute.",
      "timer": 10,
      "uses": [
        "0-4",
        "0-5",
        "0-6"
      ]
    },
    {
      "title": "Milk",
      "text": "Pour in the milk and simmer, stirring, until it has almost disappeared, about 3 minutes.",
      "timer": 3,
      "uses": [
        "0-7"
      ]
    },
    {
      "title": "Simmer",
      "text": "Add the crushed tomatoes, broth, dried oregano, bay leaf, salt and pepper. Bring to a bubble, then simmer gently, partly covered, 30 minutes, stirring now and then. Discard the bay leaf.",
      "timer": 30,
      "uses": [
        "0-8",
        "0-9",
        "0-10",
        "0-11",
        "0-12",
        "0-13"
      ]
    },
    {
      "title": "Cook the pasta",
      "text": "For the last 15 minutes, bring a large pot of water to a boil with the salt and cook the spaghetti until al dente. Save ½ cup of the pasta water, then drain.",
      "timer": 10,
      "uses": [
        "1-0",
        "1-1"
      ]
    },
    {
      "title": "Toss and serve",
      "text": "Toss the spaghetti with about half the sauce and a splash of pasta water, then top each bowl with more sauce and the Parmesan.",
      "uses": [
        "1-2"
      ]
    }
  ],
