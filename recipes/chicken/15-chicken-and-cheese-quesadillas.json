      ]
    },
    {
      "title": "Cook the chicken",
      "text": "Heat the oil in a large skillet over medium-high and cook the chicken 5–6 minutes, stirring, until golden and 74°C (165°F). Move to a board, chop small and wipe out the skillet.",
      "timer": 6,
      "uses": [
        "0-1"
      ]
    },
    {
      "title": "Fill",
      "text": "Toss the cheddar and mozzarella together. On one half of each tortilla, layer a little cheese, then the chicken and corn, then more cheese, using it all across the 6. Fold over and press.",
      "uses": [
        "1-0",
        "1-1",
        "1-2",
        "1-3"
      ]
    },
    {
      "title": "Crisp",
      "text": "Cook 2 at a time in the dry skillet over medium, 2–3 minutes a side, pressing with a spatula, until golden and the cheese melts. Keep warm on a baking sheet in the oven.",
      "timer": 5,
      "uses": []
    },
    {
      "title": "Serve",
      "text": "Cut into wedges and serve with the sour cream and salsa.",
