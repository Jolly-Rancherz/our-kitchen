  "together": "AABA*",
  "fixIt": [
    {
      "problem": "Cheese not melted, tortilla browning",
      "fix": "Lower the heat to medium-low and cover the pan for a minute."
    },
    {
      "problem": "Soggy",
      "fix": "Pat the corn dry, and keep cooked ones on a rack or baking sheet in the warm oven, not stacked."
    },
    {
      "problem": "Filling falls out",
      "fix": "Cheese on both sides of the filling glues it in; press firmly when you flip."
    }
