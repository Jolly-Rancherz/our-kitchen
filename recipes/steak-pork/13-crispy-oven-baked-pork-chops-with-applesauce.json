  "steps": [
    {
      "title": "Carrots",
      "text": "Heat the oven to 220°C (425°F). Toss the carrots with the oil and salt on one end of a large parchment-lined baking sheet and roast 10 minutes.",
      "timer": 10,
      "uses": [
        "0-0",
        "0-1",
        "0-2"
      ]
    },
    {
      "title": "Coat",
      "text": "Pat the chops dry. Mix the panko, Parmesan, paprika, garlic powder, salt, pepper and melted butter. Dust the chops in the flour, dip in the egg, then press into the crumbs.",
      "uses": [
        "1-0",
        "1-1",
        "1-2",
        "1-3",
        "1-4",
        "1-5",
        "1-6",
        "1-7",
        "1-8",
        "1-9"
      ]
    },
    {
      "title": "Bake",
      "text": "Lay the chops on the other end of the sheet and bake 18–20 minutes, until golden and 71°C (160°F) in the centre. Rest 3 minutes.",
      "timer": 19,
      "uses": []
    },
    {
      "title": "Applesauce",
      "text": "Meanwhile, simmer the apples, water, brown sugar, cinnamon and salt in a covered pot over medium-low 12–15 minutes, until soft. Mash with a fork to the texture you like.",
      "timer": 14,
      "uses": [
        "2-0",
        "2-1",
        "2-2",
        "2-3",
        "2-4"
      ]
    },
    {
      "title": "Serve",
      "text": "Serve the chops with the carrots and warm applesauce.",
      "uses": []
    }
  ],
  "together": "AAAB*",
  "fixIt": [
    {
      "problem": "Bottoms soggy",
      "fix": "Bake on a rack set on the sheet, or flip the chops for the last 5 minutes."
    },
    {
      "problem": "Chops dry",
      "fix": "Pull them at 71°C (160°F); thin chops overshoot quickly."
    },
    {
      "problem": "Applesauce too thick",
      "fix": "Stir in a splash of water or apple juice."
    }
